manifest {
    name = 'RmetaG'
    description = 'Assembly-free, read-based metagenomics'
    version = '0.2.0'
    nextflowVersion = '>=25.04.0'
}

params {
    input = null
    outdir = 'results'
    sylph_db = null
    host_index = null
    host_index_name = null
    kraken_db = null
    bracken_read_length = 150
    gene_index = null
    gene_mapping = null
    card_db = null
    rgi_wildcard = null
    metaphlan_db = null
    humann_nucleotide_db = null
    humann_protein_db = null
    diamond_db = null
    help = false
}

process {
    cpus = 2
    memory = '4 GB'
    errorStrategy = 'terminate'
    withName: FASTP { cpus = 4; publishDir = [path: "${params.outdir}/qc/fastp", mode: 'copy', pattern: '*.{json,html,log}'] }
    withName: FASTQC_RAW { publishDir = [path: "${params.outdir}/qc/raw", mode: 'copy'] }
    withName: FASTQC_CLEAN { publishDir = [path: "${params.outdir}/qc/clean", mode: 'copy'] }
    withName: HOSTILE_CLEAN { cpus = 4; publishDir = [path: "${params.outdir}/qc/host", mode: 'copy', pattern: '*.json'] }
    withName: SYLPH_PROFILE { cpus = 4; memory = '8 GB'; publishDir = [path: "${params.outdir}/taxonomy/sylph", mode: 'copy'] }
    withName: KRAKEN2_KRAKEN2 { cpus = 4; memory = '16 GB'; publishDir = [path: "${params.outdir}/taxonomy/kraken2", mode: 'copy'] }
    withName: BRACKEN_BRACKEN { ext.args = "-r ${params.bracken_read_length} -l S"; publishDir = [path: "${params.outdir}/taxonomy/bracken", mode: 'copy'] }
    withName: MULTIQC { publishDir = [path: "${params.outdir}/multiqc", mode: 'copy'] }
    withName: KALLISTO_QUANT { cpus = 4; memory = '8 GB'; publishDir = [path: "${params.outdir}/function/kallisto", mode: 'copy'] }
    withName: FUNCTION_MATRIX { memory = '4 GB'; publishDir = [path: "${params.outdir}/matrices/function", mode: 'copy'] }
    withName: SYLPH_MATRIX { memory = '4 GB'; publishDir = [path: "${params.outdir}/matrices/taxonomy", mode: 'copy'] }
    withName: RGI_BWT { cpus = 4; memory = '8 GB'; publishDir = [path: "${params.outdir}/resistance/rgi", mode: 'copy', pattern: '*.{txt,json}'] }
    withName: METAPHLAN_METAPHLAN { cpus = 4; memory = '8 GB'; publishDir = [path: "${params.outdir}/taxonomy/metaphlan", mode: 'copy'] }
    withName: HUMANN3_HUMANN { cpus = 4; memory = '8 GB'; publishDir = [path: "${params.outdir}/function/humann", mode: 'copy'] }
    withName: DIAMOND_BLASTX { cpus = 4; memory = '8 GB'; publishDir = [path: "${params.outdir}/function/diamond", mode: 'copy'] }
}

profiles {
    docker { docker.enabled = true }
    apptainer { apptainer.enabled = true; apptainer.autoMounts = true }
    singularity { singularity.enabled = true; singularity.autoMounts = true }
    stub {
        process { withName: KRAKEN2_KRAKEN2 { memory = '1 GB' } }
        params.input = "${projectDir}/tests/samplesheet.csv"
        params.sylph_db = "${projectDir}/tests/db/sylph/stub.syldb"
        params.outdir = "${projectDir}/tests/results"
    }
    stub_all {
        process { withName: KRAKEN2_KRAKEN2 { memory = '1 GB' } }
        params.input = "${projectDir}/tests/samplesheet.csv"
        params.sylph_db = "${projectDir}/tests/db/sylph/stub.syldb"
        params.host_index = "${projectDir}/tests/db/host"
        params.host_index_name = 'stub'
        params.kraken_db = "${projectDir}/tests/db/kraken"
        params.gene_index = "${projectDir}/tests/db/kallisto/stub.idx"
        params.gene_mapping = "${projectDir}/tests/gene_functions.tsv"
        params.card_db = "${projectDir}/tests/db/card"
        params.metaphlan_db = "${projectDir}/tests/db/metaphlan"
        params.humann_nucleotide_db = "${projectDir}/tests/db/humann_nucleotide"
        params.humann_protein_db = "${projectDir}/tests/db/humann_protein"
        params.diamond_db = "${projectDir}/tests/db/diamond/stub.dmnd"
        params.outdir = "${projectDir}/tests/results_all"
    }
}
